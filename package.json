{
  "name": "telinha-do-botecao",
  "version": "0.1.4",
  "private": true,
  "description": "Compartilhador de tela P2P com WebRTC - gratuito e sem travamentos",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "cd server && node index.mjs",
    "dev:web": "cd web && npm run dev",
    "install:all": "cd server && npm install && cd ../web && npm install",
    "build": "cd web && npm run build",
    "test": "npm test --prefix web",
    "test:load": "node scripts/load-test.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "concurrently": "^9.1.0"
  }
}
