{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Telinha do Botecao",
  "version": "0.1.3",
  "identifier": "com.botecao.telinha",
  "build": {
    "beforeDevCommand": "npm --prefix web run dev",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm --prefix web run build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Telinha do Botecao",
        "width": 1280,
        "height": 800,
        "theme": "Dark",
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
